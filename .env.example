# InnerOS Executable World — local runtime (never commit secrets)

# AssemblyAI (optional voice adapter)
ASSEMBLYAI_API_KEY=
VOICEOPS_ENABLE_LIVE_ASSEMBLYAI=true

# Boson (optional voice adapter)
BOSON_API_KEY=
VOICEOPS_ENABLE_BOSON=false

# AgentX (hackathon repo only)
AGENTX_API_KEY=
AGENTX_ENDPOINT=https://api.agentx.ai/v1
EXECUTABLE_ENABLE_AGENTX=false

# VeloDB (hackathon repo only)
VELODB_URL=
VELODB_API_KEY=
EXECUTABLE_ENABLE_VELODB=false

# Other optional adapters
EXECUTABLE_ENABLE_EDGEONE=false
EDGEONE_ZONE_ID=
EXECUTABLE_ENABLE_MEMORIES_AI=false
MEMORIES_AI_API_KEY=
EXECUTABLE_ENABLE_WORKBUDDY=false
WORKBUDDY_API_KEY=

# Core local
VOICEOPS_AMD_ENDPOINT=http://127.0.0.1:18000/v1/chat/completions
VOICEOPS_ENABLE_GOVERNED_TOOLS=true

# Home Assistant LIVE
HASS_URL=http://192.168.1.4:8123
HASS_TOKEN=
VOICEOPS_HA_ALLOW_DISCOVERED=true

# Grandstream AMI
VOICEOPS_AMI_HOST=192.168.1.1
VOICEOPS_AMI_PORT=5038
