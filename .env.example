# InnerOS Executable World — local runtime (never commit secrets)

# AssemblyAI (optional voice adapter)
ASSEMBLYAI_API_KEY=
VOICEOPS_ENABLE_LIVE_ASSEMBLYAI=true

# Boson (optional voice adapter)
BOSON_API_KEY=
VOICEOPS_ENABLE_BOSON=false

# AgentX — SELF-HOSTED LOCAL ONLY (no paid hosted API)
EXECUTABLE_ENABLE_AGENTX=false
AGENTX_SELF_HOSTED_URL=http://127.0.0.1:4700
AGENTX_API_KEY=
# Optional override: AGENTX_OTLP_URL=http://127.0.0.1:4700/api/v1/otel/v1/traces

# VeloDB — MySQL-compatible execution memory (NOT REST URL/API key)
EXECUTABLE_ENABLE_VELODB=false
VELODB_HOST=lb-19722502-64fe987bf0d59678.elb.us-west-1.amazonaws.com
VELODB_PORT=9030
VELODB_USER=admin
VELODB_PASSWORD=
VELODB_DATABASE=inneros_executable_world

# Tencent EdgeOne — optional witness (NOT an InnerOS migration target)
EXECUTABLE_ENABLE_EDGEONE=false
EDGEONE_PAGES_PROJECT=inneros-executable-world-2026
EDGEONE_WITNESS_URL=
EDGEONE_ZONE_ID=

# Local evidence (always written)
VOICEOPS_EVIDENCE_DIR=evidence

# Out of scope for Executable World — leave disabled
EXECUTABLE_ENABLE_MEMORIES_AI=false
EXECUTABLE_ENABLE_WORKBUDDY=false

# Core local
VOICEOPS_AMD_ENDPOINT=http://127.0.0.1:18000/v1/chat/completions
VOICEOPS_ENABLE_GOVERNED_TOOLS=true

# Home Assistant LIVE
HASS_URL=http://192.168.1.4:8123
HASS_TOKEN=
VOICEOPS_HA_ALLOW_DISCOVERED=true

# Grandstream UCM6104 telephony (Guayaquil LAN)
VOICEOPS_TELEPHONY_AMI_HOST=192.168.1.6
VOICEOPS_TELEPHONY_AMI_PORT=7777
VOICEOPS_TELEPHONY_AMI_USERNAME=
VOICEOPS_TELEPHONY_AMI_SECRET=
VOICEOPS_TELEPHONY_ORIGINATE_ENABLED=false
VOICEOPS_TELEPHONY_ORIGINATE_CONTEXT=from-internal
VOICEOPS_TELEPHONY_LOCAL_IP=192.168.1.4
# Server SIP agent (NOT your Zoiper extension — e.g. 1003 on PBX)
VOICEOPS_TELEPHONY_SIP_AGENT_EXT=1003
VOICEOPS_TELEPHONY_SIP_AGENT_SECRET=
VOICEOPS_TELEPHONY_AGENT_EXTENSION=1003
VOICEOPS_TELEPHONY_SIP_PORT=4321
VOICEOPS_TELEPHONY_CALL_SECONDS=45
VOICEOPS_TELEPHONY_DEFAULT_EXTENSION=1004
